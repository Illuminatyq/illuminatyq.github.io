---
import '../styles/global.css';
import {
  Send, Mail, Sun, Moon, Github, ChevronDown, Menu, X, MapPin, Globe, Database, Server,
  Terminal, Bug, Smartphone, Apple, GitBranch, Activity, Layers, Code2, Play, Square,
  CheckCircle2, XCircle, AlertTriangle, Clock, ExternalLink, FileText, Sparkles, Bot,
  Eye, Network, Boxes, Rocket, Figma, Users, GraduationCap, Briefcase, ArrowUpRight,
  Filter, Search, RotateCcw, Container, Braces, FlaskConical, ListChecks, Workflow,
  BarChart3, Download, Copy, Shuffle, Languages, PhoneCall, Radio, Printer, ArrowUp,
  Target, Shield, Zap,
} from 'lucide-astro';
import {
  profile, ticker, metrics, skills, skillGroups, levelLegend,
  jobs, earlyCareer, stack, projects, tests, suites,
} from '../data/cv';

const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p}`;

const icons: Record<string, any> = {
  Send, Mail, Github, Database, Server, Terminal, Bug, Smartphone, Apple, GitBranch,
  Activity, Layers, Code2, Play, FlaskConical, BarChart3, Container, Boxes, Braces,
  ListChecks, Workflow, Figma, Users, FileText, Sparkles, Bot, Network, Globe,
  PhoneCall, Radio, Rocket, Eye,
};

const navLinks = [
  { href: '#about', label: 'Обо мне' },
  { href: '#results', label: 'Результаты' },
  { href: '#experience', label: 'Опыт' },
  { href: '#skills', label: 'Навыки' },
  { href: '#console', label: 'Стенд' },
  { href: '#stack', label: 'Стек' },
  { href: '#projects', label: 'Проекты' },
  { href: '#contacts', label: 'Контакты' },
];

const sectionMeta = [
  { id: 'results', n: '01', title: 'Результаты в цифрах', sub: 'Только то, что могу подтвердить и объяснить на собеседовании', accent: 'var(--color-brand)' },
  { id: 'experience', n: '02', title: 'Опыт работы', sub: 'Продукты, зона ответственности, результаты и процессы', accent: 'var(--color-pass)' },
  { id: 'skills', n: '03', title: 'Навыки и уровень владения', sub: 'Шкала по частоте реального применения, а не по абстрактным процентам', accent: 'var(--color-flaky)' },
  { id: 'console', n: '04', title: 'Стенд регрессионного прогона', sub: 'Интерактивная демонстрация того, как я мыслю прогон, ретраи и отчётность', accent: 'var(--color-cyan)' },
  { id: 'stack', n: '05', title: 'Технический стек', sub: 'Инструменты по областям применения', accent: 'var(--color-skip)' },
  { id: 'projects', n: '06', title: 'Проекты', sub: 'Автоматизация, этот сайт и продукт в разработке', accent: 'var(--color-magenta)' },
];

const statusMeta: Record<string, { label: string; color: string }> = {
  pass: { label: 'PASS', color: 'var(--color-pass)' },
  fail: { label: 'FAIL', color: 'var(--color-fail)' },
  flaky: { label: 'FLAKY', color: 'var(--color-flaky)' },
  skip: { label: 'SKIP', color: 'var(--color-skip)' },
  pending: { label: 'QUEUE', color: '#5b6b8c' },
};
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Данил Степанюк — QA Engineer Middle+. Web, iOS, Android, Backend. Интеграции, микросервисы, автоматизация на pytest и Playwright." />
    <meta name="theme-color" content="#04060d" />
    <meta property="og:title" content="Данил Степанюк · QA Engineer" />
    <meta property="og:description" content="Портфолио инженера по тестированию: опыт, результаты, интерактивный стенд прогона." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>Данил Степанюк · QA Engineer Middle+</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('qa-theme') || 'dark';
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="antialiased">
    <div class="layer aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="layer grid-layer" aria-hidden="true"></div>
    <div class="layer spotlight" aria-hidden="true"></div>
    <div class="layer grain" aria-hidden="true"></div>
    <div class="cursor-ring" id="cursor-ring" aria-hidden="true"></div>

    <!-- ================= HEADER ================= -->
    <header class="fixed top-0 inset-x-0 z-50 border-b border-paperedge dark:border-edge bg-paper/85 dark:bg-void/80 backdrop-blur-xl">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
        <a href="#about" class="flex items-center gap-2.5 shrink-0 group" aria-label="В начало">
          <span class="relative grid place-items-center w-9 h-9 rounded-xl bg-graphite dark:bg-panel2 border border-paperedge dark:border-edge">
            <Eye class="w-4.5 h-4.5 text-brand" style="width:18px;height:18px" />
            <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-pass border-2 border-paper dark:border-void"></span>
          </span>
          <span class="font-extrabold tracking-tight text-graphite dark:text-white">
            illuminaty<span class="text-brand">.</span><span class="font-mono text-xs text-slate-500 dark:text-slate-400">qa</span>
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-5" aria-label="Основная навигация">
          {navLinks.map((l) => (
            <a href={l.href} class="nav-link text-[13px] font-semibold text-slate-600 dark:text-slate-400 hover:text-brand transition-colors" data-nav={l.href.slice(1)}>{l.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <button id="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="true"
            class="grid place-items-center w-9 h-9 rounded-xl border border-paperedge dark:border-edge bg-paper2/70 dark:bg-panel2/70 hover:border-brand transition-colors">
            <Sun class="hidden dark:block text-flaky" style="width:17px;height:17px" />
            <Moon class="block dark:hidden text-brand" style="width:17px;height:17px" />
          </button>
          <a href={profile.telegram} target="_blank" rel="noopener"
            class="hidden sm:inline-flex items-center gap-2 px-4 h-9 rounded-xl bg-brand text-white text-[13px] font-bold hover:bg-cyan hover:text-graphite transition-colors">
            <Send style="width:15px;height:15px" /> Написать
          </a>
          <button id="menu-btn" type="button" aria-label="Меню" aria-expanded="false"
            class="lg:hidden grid place-items-center w-9 h-9 rounded-xl border border-paperedge dark:border-edge bg-paper2/70 dark:bg-panel2/70">
            <Menu class="menu-open" style="width:18px;height:18px" />
            <X class="menu-close hidden" style="width:18px;height:18px" />
          </button>
        </div>
      </div>
      <div class="h-0.5 bg-transparent"><div class="progress-line h-full bg-gradient-to-r from-brand via-cyan to-pass"></div></div>

      <div id="drawer" class="drawer lg:hidden absolute inset-x-0 top-full border-b border-paperedge dark:border-edge bg-paper/97 dark:bg-void/97 backdrop-blur-xl">
        <nav class="max-w-6xl mx-auto px-4 py-4 grid grid-cols-2 gap-2" aria-label="Мобильная навигация">
          {navLinks.map((l) => (
            <a href={l.href} class="drawer-link px-3 py-2.5 rounded-xl text-sm font-semibold border border-paperedge dark:border-edge bg-paper2/60 dark:bg-panel2/60">{l.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="relative z-10 max-w-6xl mx-auto px-4 pt-24 pb-20">

      <!-- ================= HERO ================= -->
      <section id="about" class="pt-8 pb-14">
        <div class="grid lg:grid-cols-[1.35fr_1fr] gap-12 items-center">
          <div class="reveal">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-pass/40 bg-pass/10 mb-6">
              <span class="led"></span>
              <span class="font-mono text-[11px] font-bold tracking-widest text-pass uppercase">Open to work · Remote</span>
            </div>

            <h1 class="text-[2.6rem] leading-[1.05] sm:text-6xl font-extrabold tracking-tight text-graphite dark:text-white mb-4">
              Данил<br class="sm:hidden" /> Степанюк
            </h1>

            <p class="font-mono text-sm sm:text-base text-brand mb-6">
              QA Engineer · Middle+ · 4.5 года в тестировании
            </p>

            <p class="text-[15px] sm:text-[17px] leading-relaxed text-slate-600 dark:text-slate-400 max-w-2xl mb-8">
              {profile.tagline}
            </p>

            <div class="flex flex-wrap gap-3 mb-8">
              <a href={profile.telegram} target="_blank" rel="noopener"
                class="inline-flex items-center gap-2 px-5 h-12 rounded-xl bg-brand text-white font-bold hover:-translate-y-0.5 hover:bg-cyan hover:text-graphite transition-all shadow-lg shadow-brand/25">
                <Send style="width:17px;height:17px" /> Telegram
              </a>
              <a href={`mailto:${profile.email}`}
                class="inline-flex items-center gap-2 px-5 h-12 rounded-xl border border-paperedge dark:border-edge font-bold hover:-translate-y-0.5 hover:border-brand transition-all">
                <Mail style="width:17px;height:17px" /> Email
              </a>
              <button id="print-cv" type="button"
                class="no-print inline-flex items-center gap-2 px-5 h-12 rounded-xl border border-paperedge dark:border-edge font-bold hover:-translate-y-0.5 hover:border-pass transition-all">
                <Printer style="width:17px;height:17px" /> Сохранить CV в PDF
              </button>
            </div>

            <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-slate-500 dark:text-slate-500">
              <span class="inline-flex items-center gap-1.5"><MapPin style="width:14px;height:14px" /> {profile.location}</span>
              <span class="inline-flex items-center gap-1.5"><Globe style="width:14px;height:14px" /> {profile.format}</span>
              <span class="inline-flex items-center gap-1.5"><Languages style="width:14px;height:14px" /> {profile.english}</span>
            </div>
          </div>

          <!-- PHOTO -->
          <div class="reveal flex justify-center lg:justify-end">
            <div class="photo-wrap relative w-[270px] h-[330px] sm:w-[310px] sm:h-[380px]" id="photo">
              <div class="photo-ring" aria-hidden="true"></div>
              <div class="orbit" aria-hidden="true"><span></span></div>
              <div class="photo-tilt relative w-full h-full">
                <div class="photo-frame w-full h-full">
                  <img src={asset('avatar.jpg')} alt="Данил Степанюк, QA Engineer" width="310" height="380" />
                  <div class="photo-sweep" aria-hidden="true"></div>
                  <span class="bracket tl"></span><span class="bracket tr"></span>
                  <span class="bracket bl"></span><span class="bracket br"></span>
                  <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-void/90 to-transparent">
                    <div class="font-mono text-[10px] tracking-widest text-pass">IDENTITY VERIFIED</div>
                    <div class="font-mono text-[10px] text-slate-400">qa-engineer · middle+</div>
                  </div>
                </div>
              </div>
              <div class="float-chip absolute -left-5 top-10 panel px-3 py-2 shadow-xl">
                <div class="font-mono text-[10px] text-slate-500">REGRESSION</div>
                <div class="font-bold text-sm text-pass">−50% времени</div>
              </div>
              <div class="float-chip b absolute -right-4 top-1/3 panel px-3 py-2 shadow-xl">
                <div class="font-mono text-[10px] text-slate-500">PLATFORMS</div>
                <div class="font-bold text-sm text-cyan">Web · iOS · Android</div>
              </div>
              <div class="float-chip c absolute -left-3 bottom-8 panel px-3 py-2 shadow-xl">
                <div class="font-mono text-[10px] text-slate-500">ROLE</div>
                <div class="font-bold text-sm text-flaky">Sole QA in team</div>
              </div>
            </div>
          </div>
        </div>

        <!-- TICKER -->
        <div class="ticker mt-14 py-3 border-y border-paperedge dark:border-edge">
          <div class="ticker-track font-mono text-[11px] uppercase tracking-widest text-slate-500 dark:text-slate-500">
            {[...ticker, ...ticker].map((t) => (
              <span class="inline-flex items-center gap-2 whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-pass"></span>{t}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= RESULTS ================= -->
      <section id="results" class="py-14" style="--accent: var(--color-brand)">
        <div class="reveal flex items-start gap-4 mb-9">
          <span class="font-mono text-xs text-brand pt-2">01</span>
          <div class="flex-1">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-graphite dark:text-white">Результаты в цифрах</h2>
            <p class="text-sm text-slate-500 mt-1">Только то, что могу подтвердить и объяснить на собеседовании</p>
          </div>
          <span class="hidden sm:block h-px flex-1 max-w-[160px] mt-5 bg-gradient-to-r from-brand to-transparent"></span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {metrics.map((m, i) => (
            <article class="reveal panel glow-card p-5 flex flex-col" style={`--accent:${m.accent}; transition-delay:${i * 45}ms`}>
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="text-[2rem] leading-none font-extrabold" style={`color:${m.accent}`}>
                  {m.display ? m.display : (<><span data-num={m.num} data-dec={m.dec ?? 0}>0</span>{m.suffix}</>)}
                </div>
                {m.delta && <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-pass/12 text-pass border border-pass/30">{m.delta}</span>}
              </div>
              <h3 class="font-bold text-[13px] leading-snug text-graphite dark:text-slate-100 mb-2">{m.label}</h3>
              <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-500 flex-1">{m.note}</p>
              <div class="mt-4 h-8 flex items-end gap-1" aria-hidden="true">
                {m.viz === 'spark' && m.series?.map((v, k) => (
                  <span class="flex-1 rounded-sm" style={`height:${20 + (v / Math.max(...m.series!)) * 80}%; background:${m.accent}; opacity:${0.25 + (k / m.series!.length) * 0.75}`}></span>
                ))}
                {m.viz === 'bars' && m.series?.map((v, k) => (
                  <span class="flex-1 rounded-sm" style={`height:${(v / Math.max(...m.series!)) * 100}%; background:${m.accent}; opacity:${0.3 + (k / m.series!.length) * 0.7}`}></span>
                ))}
                {m.viz === 'ring' && (
                  <div class="flex gap-1.5 w-full">
                    {['Web', 'iOS', 'Android'].map((p) => (
                      <span class="flex-1 text-center font-mono text-[9px] py-1 rounded-md border" style={`border-color:${m.accent}; color:${m.accent}`}>{p}</span>
                    ))}
                  </div>
                )}
                {m.viz === 'split' && (
                  <div class="w-full h-2 rounded-full overflow-hidden flex">
                    <span class="h-full" style={`width:50%; background:${m.accent}`}></span>
                    <span class="h-full flex-1" style={`background:color-mix(in oklab, ${m.accent} 25%, transparent)`}></span>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ================= EXPERIENCE ================= -->
      <section id="experience" class="py-14" style="--accent: var(--color-pass)">
        <div class="reveal flex items-start gap-4 mb-9">
          <span class="font-mono text-xs text-pass pt-2">02</span>
          <div class="flex-1">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-graphite dark:text-white">Опыт работы</h2>
            <p class="text-sm text-slate-500 mt-1">Продукты, зона ответственности, результаты и процессы</p>
          </div>
        </div>

        <div class="space-y-6">
          {jobs.map((job, idx) => (
            <article class="reveal panel glow-card overflow-hidden" style={`--accent:${job.accent}`}>
              <div class="p-6 sm:p-7">
                <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                  <div>
                    <div class="flex items-center gap-2 mb-1.5">
                      <Briefcase style="width:16px;height:16px;color:var(--color-pass)" />
                      <h3 class="text-xl font-extrabold text-graphite dark:text-white">{job.role}</h3>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      {job.url
                        ? <a href={job.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-bold hover:underline" style={`color:${job.accent}`}>{job.company}<ExternalLink style="width:13px;height:13px" /></a>
                        : <span class="font-bold" style={`color:${job.accent}`}>{job.company}</span>}
                      <span class="text-xs text-slate-500">{job.place}</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-mono text-xs text-slate-500">{job.period}</div>
                    <div class="font-mono text-[11px] mt-1 px-2 py-0.5 rounded-md border border-paperedge dark:border-edge inline-block">{job.duration}</div>
                  </div>
                </div>

                <p class="text-[14px] leading-relaxed text-slate-600 dark:text-slate-400 mb-5">{job.context}</p>

                <div class="grid md:grid-cols-3 gap-3 mb-5">
                  {job.wins.map((w) => (
                    <div class="rounded-xl p-4 border border-paperedge dark:border-edge bg-paper2/50 dark:bg-panel2/40">
                      <div class="flex items-center gap-2 mb-2">
                        <Target style="width:14px;height:14px" />
                        <h4 class="font-bold text-[13px]" style={`color:${job.accent}`}>{w.title}</h4>
                      </div>
                      <p class="text-[12px] leading-relaxed text-slate-600 dark:text-slate-400">{w.text}</p>
                    </div>
                  ))}
                </div>

                <div class="flex flex-wrap gap-1.5 mb-5">
                  {job.stack.map((s) => <span class="chip font-mono">{s}</span>)}
                </div>

                <button type="button" class="acc-btn no-print inline-flex items-center gap-2 text-[13px] font-bold hover:gap-3 transition-all" style={`color:${job.accent}`} aria-expanded={idx === 0 ? 'true' : 'false'}>
                  <span class="acc-label">{idx === 0 ? 'Свернуть подробности' : 'Показать обязанности и процессы'}</span>
                  <ChevronDown class="chev" style="width:15px;height:15px" />
                </button>
              </div>

              <div class={`acc no-print ${idx === 0 ? 'open' : ''}`}>
                <div>
                  <div class="px-6 sm:px-7 pb-7 pt-1 grid md:grid-cols-2 gap-6 border-t border-paperedge dark:border-edge">
                    <div>
                      <h4 class="font-mono text-[11px] uppercase tracking-widest text-slate-500 mb-3 mt-4">Зона ответственности</h4>
                      <ul class="space-y-2.5">
                        {job.duties.map((d) => (
                          <li class="flex gap-2.5 text-[13px] leading-relaxed text-slate-600 dark:text-slate-400">
                            <span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0" style={`background:${job.accent}`}></span><span>{d}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h4 class="font-mono text-[11px] uppercase tracking-widest text-slate-500 mb-3 mt-4">Как был устроен процесс</h4>
                      <ul class="space-y-2.5">
                        {job.process.map((p) => (
                          <li class="flex gap-2.5 text-[13px] leading-relaxed text-slate-600 dark:text-slate-400">
                            <span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0 bg-slate-400"></span><span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="reveal panel p-6 mt-6">
          <h3 class="font-mono text-[11px] uppercase tracking-widest text-slate-500 mb-4">До QA: телеком и техническая поддержка</h3>
          <div class="space-y-4">
            {earlyCareer.map((e) => (
              <div class="flex flex-col sm:flex-row gap-1 sm:gap-5 sm:items-baseline border-l-2 border-paperedge dark:border-edge pl-4">
                <span class="font-mono text-[11px] text-slate-500 sm:w-56 shrink-0">{e.period}</span>
                <div>
                  <div class="font-bold text-sm text-graphite dark:text-slate-200">{e.company} · <span class="font-medium text-slate-500">{e.role}</span></div>
                  <p class="text-[12px] text-slate-500 mt-0.5">{e.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= SKILLS ================= -->
      <section id="skills" class="py-14" style="--accent: var(--color-flaky)">
        <div class="reveal flex items-start gap-4 mb-6">
          <span class="font-mono text-xs text-flaky pt-2">03</span>
          <div class="flex-1">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-graphite dark:text-white">Навыки и уровень владения</h2>
            <p class="text-sm text-slate-500 mt-1">Шкала по частоте реального применения, а не по абстрактным процентам</p>
          </div>
        </div>

        <div class="reveal panel p-4 mb-5 flex flex-wrap gap-x-5 gap-y-1.5">
          {levelLegend.map((l) => <span class="font-mono text-[11px] text-slate-500">{l}</span>)}
        </div>

        <div class="reveal flex flex-wrap gap-2 mb-6" id="skill-filters" role="group" aria-label="Фильтр навыков">
          {skillGroups.map((g, i) => (
            <button type="button" data-group={g.id} aria-pressed={i === 0 ? 'true' : 'false'}
              class="skill-filter px-3.5 py-2 rounded-xl text-[12px] font-bold border transition-all"
